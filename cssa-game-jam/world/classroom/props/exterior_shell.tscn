[node name="ExteriorShell" type="Node3D"]
editor_description = "Visual-only moon-base cladding outside the classroom walls, roof and exit. Collision stays on the Room greybox boxes. No dynamic lights here: in the Compatibility renderer every light re-draws the whole moon mesh. Hull panels use world-space seams, so boxes can be scaled freely."

