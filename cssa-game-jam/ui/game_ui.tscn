offset_top = 650.0
offset_right = 370.0
offset_bottom = 1650.0
grow_horizontal = 2
modulate = Color(1, 0.85, 0.2, 1)
theme_override_font_sizes/font_size = 31
autowrap_mode = 3
horizontal_alignment = 1
text = "EPISODE I\nA NEW CURRICULUM\n\nIt is a period of intergalactic confusion. Having raided Earth, curious extraterrestrials have become obsessed with human culture, snacks, and questionable television broadcasts.\n\nTheir researchers cloned one human specimen. Fresh subjects now tumble down a cold metal chute into an orbiting academy. You are its latest transfer student.\n\nThe syllabus is simple: attend class, or be vaporized. Eat to survive. Spend your allowance. Build a starship, one suspicious purchase at a time.\n\nAnd whatever you do…\n\nDO NOT DISTURB THE TEACHER."
