[sub_resource type="Shader" id="CircularChargeShader"]
code = "shader_type canvas_item;
uniform float progress : hint_range(0.0, 1.0) = 0.65;
void fragment() {
	vec2 p = UV * 2.0 - vec2(1.0);
	float r = length(p);
	float ring = smoothstep(0.87, 0.89, r) * (1.0 - smoothstep(0.915, 0.935, r));
	vec2 b = vec2(-0.70710678, 0.70710678);
	vec2 c = vec2(0.70710678, 0.70710678);
	float deg = degrees(atan(dot(p, c), dot(p, b)));
	float in_semi = step(-90.0, deg) * step(deg, 90.0);
	float t = clamp((deg + 90.0) / 180.0, 0.0, 1.0);
	float arc = 1.0 - smoothstep(progress - 0.015, progress + 0.015, t);
	vec4 track_col = vec4(0.02, 0.12, 0.22, 0.4);
	vec4 fill_col = vec4(0.18, 0.95, 1.0, 0.95);
	vec4 col = mix(track_col, fill_col, arc * step(0.001, progress));
	COLOR = vec4(col.rgb, col.a * ring * in_semi);
}
"

