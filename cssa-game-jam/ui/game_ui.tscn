[sub_resource type="Shader" id="CircularChargeShader"]
code = "shader_type canvas_item;
uniform float progress : hint_range(0.0, 1.0) = 0.65;
void fragment() {
	vec2 p = UV * 2.0 - vec2(1.0);
	float r = length(p);
	float ring = smoothstep(0.76, 0.80, r) * (1.0 - smoothstep(0.92, 0.96, r));
	float angle = fract(atan(p.x, -p.y) / 6.2831853 + 1.0);
	float arc = 1.0 - smoothstep(progress - 0.01, progress + 0.01, angle);
	vec4 track_col = vec4(0.01, 0.08, 0.16, 0.45);
	vec4 fill_col = vec4(0.18, 0.95, 1.0, 0.95);
	vec4 col = mix(track_col, fill_col, arc * step(0.001, progress));
	COLOR = vec4(col.rgb, col.a * ring);
}
"

[sub_resource type="ShaderMaterial" id="CircularChargeMat"]
shader = SubResource("CircularChargeShader")
shader_parameter/progress = 0.65

