[gd_scene format=3]

[node name="Controls" type="PanelContainer"]
layout_mode = 2

[node name="Columns" type="HBoxContainer" parent="."]
layout_mode = 2
theme_override_constants/separation = 20

[node name="MovementControls" type="Label" parent="Columns"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
theme_override_colors/font_color = Color(0.68, 0.88, 0.95, 0.9)
theme_override_colors/font_outline_color = Color(0, 0.08, 0.16, 0.95)
theme_override_constants/line_spacing = 4
theme_override_constants/outline_size = 3
theme_override_font_sizes/font_size = 20
text = "[WASD] Move
[Shift] Sprint
[Space] Jump / Stand / Escape
[E] Grab / Sit / Interact
[Q] Drop"
autowrap_mode = 2

[node name="ActionControls" type="Label" parent="Columns"]
layout_mode = 2
size_flags_horizontal = 3
size_flags_vertical = 0
theme_override_colors/font_color = Color(0.68, 0.88, 0.95, 0.9)
theme_override_colors/font_outline_color = Color(0, 0.08, 0.16, 0.95)
theme_override_constants/line_spacing = 4
theme_override_constants/outline_size = 3
theme_override_font_sizes/font_size = 20
text = "[Left-click] Punch / Hold to Throw
[Right-click] Eat / Use
[F] Vent Gas
[Tab] Class Register
[H] Incident Feed
[Esc] Pause Menu"
autowrap_mode = 2
